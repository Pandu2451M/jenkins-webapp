pipeline{
    agent any
    stages{
        stage('Pre Build Actions'){
            steps{
                    sh npm install
                    sh 'sudo systemctl status ngnix || sudo apt instal ngnix -y'
                    sh 'sudo systemctl start ngnix'
            }
        }
        stage('Build'){
            steps{
                    sh npm run build
            }
        }
        stage('Post Build Actions'){
            steps{
                    sh 'echo "Build Completed Successfully"'
                    sh 'echo "Done"'
                    sh 'sudo cp -r dist/* /var/www/html/'
                    sh 'sudo systemctl restart ngnix'
            }
        }
    }
}