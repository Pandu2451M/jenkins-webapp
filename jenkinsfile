pipeline {
    agent any
    
        stage('Deployment') {
            steps {
                sh """
                ssh ubuntu@3.7.248.174 
                scp docker-compose.yaml ubuntu@3.7.248.174 /home/ubuntu/docker-compose.yaml
                ssh ubuntu@3.7.248.174 '''
                cd /home/ubuntu
                docker-compose down
                docker-compose up -d
                '''
                """
            }
        }
    }